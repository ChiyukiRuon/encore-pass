EncorePass_SIGNING_MODE=preview
PASS_TYPE_IDENTIFIER=
APPLE_TEAM_ID=
PASS_ORGANIZATION_NAME=EncorePass
PASS_CERT_PATH=/run/secrets/pass-cert.pem
PASS_KEY_PATH=/run/secrets/pass-key.pem
PASS_KEY_PASSWORD=
APPLE_WWDR_CERT_PATH=/run/secrets/wwdr.pem
MAX_REQUEST_SIZE_MB=10
# Required in production, unless explicitly opting into trusted local preview.
ACCESS_PASSWORD=
ALLOW_UNAUTHENTICATED=false
# Set to the external HTTPS origin when reverse-proxying.
APP_ORIGIN=
